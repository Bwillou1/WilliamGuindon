							-73.8585018,45.69907080000001,0 -73.8460134,45.6904078,0 -73.843181,45.698801,0 -73.8505195,45.7037164,0 -73.8585018,45.69907080000001,0 
						</coordinates>
					</LinearRing>
				</outerBoundaryIs>
			</Polygon>
		</Placemark>
		<Placemark id="5C939EEAFC000005">
			<name>La tourbière de Blainville</name>
			<description><![CDATA[<div><b>name</b>: La tourbière de Blainville</div><div><b>description</b>: Miliieu naturel jugé exceptionnel par la Communauté métropolitaine de Montréal (CMM). La tourbière de Blainville est l'un des derniers milieux humides d'envergure dans la région.</div>]]></description>
			<styleUrl>#__managed_style_0B274FDEAF402003FF74</styleUrl>
			<ExtendedData>
				<SchemaData schemaUrl="#__managed_schema">
					<SimpleData name="COL5C939EEBCA51CFBF">La tourbière de Blainville</SimpleData>
					<SimpleData name="COL5C939EEBCA50544A">Miliieu naturel jugé exceptionnel par la Communauté métropolitaine de Montréal (CMM). La tourbière de Blainville est l&apos;un des derniers milieux humides d&apos;envergure dans la région.</SimpleData>
				</SchemaData>
			</ExtendedData>
			<Point>
