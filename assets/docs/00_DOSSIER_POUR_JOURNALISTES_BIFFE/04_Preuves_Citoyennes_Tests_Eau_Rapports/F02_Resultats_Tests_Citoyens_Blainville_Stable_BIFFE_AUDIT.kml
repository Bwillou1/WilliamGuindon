	<Folder id="5C939EEAFB000001">
		<name>Repères</name>
		<open>1</open>
		<styleUrl>#__managed_style_10595FC338402003FF72</styleUrl>
		<Placemark id="5C939EEAFC000002">
			<name>Usine de Stablex</name>
			<description><![CDATA[<div><b>name</b>: Usine de Stablex<br></div><div><b>description</b>: Usine où Stablex traite des déchets industriels et des sols contaminés pour les préparer à l'enfouissement.<br></div>]]></description>
			<styleUrl>#__managed_style_172A81E37B402003FF73</styleUrl>
			<ExtendedData>
				<SchemaData schemaUrl="#__managed_schema">
					<SimpleData name="COL5C939EEBCA51CFBF">Usine de Stablex</SimpleData>
					<SimpleData name="COL5C939EEBCA50544A">Usine où Stablex traite des déchets industriels et des sols contaminés pour les préparer à l&apos;enfouissement.</SimpleData>
				</SchemaData>
			</ExtendedData>
			<gx:Carousel>
				<gx:Image kml:id="hosted_image_">
					<gx:imageUrl>https://earth.usercontent.google.com/hostedimage/e/*/4AE5a_Gzj4YcJ1DB0_a6ARtvZq8yU0yqZDZ_YrkezttYUMc-zFYhYIqeUObDGbeLvbNeKEuw02IZ77XBGQOijFwoEogmtf9uuhQfZ8Edirac-TbuQ2Vfkj9c-Nc9CP0m2u9zwZHrnSuZRAmr7Kyt7daJx0A4P0bd8Mr99YBnHwfI_AiRN8JT7TlfnJCK7TaPWI8wJOQbU9u0IkWlRAjSEwOPbmIyQ9ApcbFd0YtcBgdCUpMvKNlnfyQHbaMGFdVYAAaYLmHz0s7i9cdpIgiUg?fife=s{size}</gx:imageUrl>
				</gx:Image>
			</gx:Carousel>
			<Polygon>
				<outerBoundaryIs>
					<LinearRing>
						<coordinates>
							-73.8622783,45.6721483,0 -73.86040079999999,45.6707539,0 -73.8582979,45.6722833,0 -73.8574825,45.67178850000001,0 -73.8567422,45.6727031,0 -73.8571929,45.6737976,0 -73.858491,45.6747572,0 -73.85804039999999,45.67510949999999,0 -73.85883440000001,45.67559680000001,0 -73.8595103,45.6749971,0 -73.8589309,45.6745623,0 -73.8622783,45.6721483,0 
						</coordinates>
					</LinearRing>
				</outerBoundaryIs>
			</Polygon>
		</Placemark>
		<Placemark id="5C939EEAFC000003">
			<name>Site d&apos;enfouissement</name>
			<description><![CDATA[<div><b>name</b>: Site d'enfouissement<br></div><div><b>description</b>: Après avoir stabilisé les produits dangereux dans son usine, Stablex les mélange à un produit qui s'apparente à du ciment pour former du "stablex". Celui-ci est ensuite entreposé en "cellules", sorte de buttes de ciment qui sont recouvertes de végétation après avoir atteint leur capacité.<br></div>]]></description>
			<styleUrl>#__managed_style_0ED4902591402003FF73</styleUrl>
			<ExtendedData>
				<SchemaData schemaUrl="#__managed_schema">
					<SimpleData name="COL5C939EEBCA51CFBF">Site d&apos;enfouissement</SimpleData>
					<SimpleData name="COL5C939EEBCA50544A">Après avoir stabilisé les produits dangereux dans son usine, Stablex les mélange à un produit qui s&apos;apparente à du ciment pour former du &quot;stablex&quot;. Celui-ci est ensuite entreposé en &quot;cellules&quot;, sorte de buttes de ciment qui sont recouvertes de végétation après avoir atteint leur capacité.</SimpleData>
				</SchemaData>
			</ExtendedData>
			<gx:Carousel>
				<gx:Image kml:id="hosted_image_">
					<gx:imageUrl>https://earth.usercontent.google.com/hostedimage/e/*/4AE5a_GyD_b66UsoVD3FAplYn8Uxps4qgElevp7la5tMR2VLXRBeJXBqOGUNuk9B0LJvpe4fwjtKrRRrQgIeTfhvukICfROH_taSmVd8--UIiVaipWz1o7SHhPesqRrJGlCv_a_7tPckN4_QiuI7dXwMdx9MbBrEJwCsW9LLwxVTXgmpWvR_gOnwT6S05lNiJDCCGDSgIOcaubGdfiHnK2lDvNQiNkPkepY8d453xSTYyNI9gc3hFEh4ZXf45hgGFg4sgTFtfk2mnIX7WlJJA?fife=s{size}</gx:imageUrl>
				</gx:Image>
			</gx:Carousel>
			<Polygon>
				<outerBoundaryIs>
					<LinearRing>
						<coordinates>
							-73.86304946825619,45.67881765100368,0 -73.85818966131994,45.67507048247192,0 -73.85215030000001,45.67909,0 -73.85481110000001,45.6810689,0 -73.8478588,45.6856861,0 -73.8604759,45.6940799,0 -73.86245,45.69270100000001,0 -73.8603042,45.6910822,0 -73.8617634,45.690063,0 -73.85931720000001,45.6880245,0 -73.8593601,45.685776,0 -73.8637159,45.6828828,0 -73.8607548,45.6805292,0 -73.86304946825619,45.67881765100368,0 
						</coordinates>
					</LinearRing>
				</outerBoundaryIs>
			</Polygon>
		</Placemark>
		<Placemark id="5C939EEAFC000004">
			<name>Site visé par l&apos;expansion de Stablex</name>
			<description><![CDATA[<div><b>name</b>: Site visé par l'expansion de Stablex</div><div><b>description</b>: L'entreprise souhaite agrandir son site d'enfouissement sur ce terrain qui appartient à la Ville de Blainville. 
Après avoir accepté de vendre le terrain à l'entreprise, la Ville de Blainville a changé d'avis et résilié l'entente. Un geste dont Stablex conteste la légalité.
Après avoir évalué le projet d'agrandissement, le BAPE a recommandé au gouvernement du Québec de ne pas l'autoriser. Le gouvernement n'a pas encore statué s'il allait de l'avant ou non avec les autorisations.


</div>]]></description>
			<styleUrl>#__managed_style_1C31FBE10B402003FF74</styleUrl>
			<ExtendedData>
				<SchemaData schemaUrl="#__managed_schema">
					<SimpleData name="COL5C939EEBCA51CFBF">Site visé par l&apos;expansion de Stablex</SimpleData>
					<SimpleData name="COL5C939EEBCA50544A">L&apos;entreprise souhaite agrandir son site d&apos;enfouissement sur ce terrain qui appartient à la Ville de Blainville. 
Après avoir accepté de vendre le terrain à l&apos;entreprise, la Ville de Blainville a changé d&apos;avis et résilié l&apos;entente. Un geste dont Stablex conteste la légalité.
Après avoir évalué le projet d&apos;agrandissement, le BAPE a recommandé au gouvernement du Québec de ne pas l&apos;autoriser. Le gouvernement n&apos;a pas encore statué s&apos;il allait de l&apos;avant ou non avec les autorisations.


</SimpleData>
				</SchemaData>
			</ExtendedData>
			<gx:Carousel>
				<gx:Image kml:id="hosted_image_">
					<gx:imageUrl>https://earth.usercontent.google.com/hostedimage/e/*/4AE5a_GzuhS345-vfr_GpEjeZWrvja9OwhNB8pI_-n6it1bCZFQZqyQUMmIF82pWDEICc7WbgYDa1VS1oi_rr8nLPzW8VD7MCY93qP3sGfmAB5puEOmdX1mke0eRN1QDUJXbBJCtt3LcCr93THvPsz26CKU67On6PfeuY7keAHgtrkyKNd_xKB1OQIQnW0Hs0tzMlTBExjE8m1MQEsy8q-fHBY-T9mR-rgPddxJXGmciEtyoUZBOzyhqhmPLnMZxJLCVKGyRLh-DX7WZsj-G4?fife=s{size}</gx:imageUrl>
				</gx:Image>
			</gx:Carousel>
			<Polygon>
