/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=()

# Fichiers dynamiques et Service Worker (sans mise en cache stale)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/data/site-state.json
  Cache-Control: public, max-age=0, must-revalidate

/status.json
  Cache-Control: public, max-age=60, stale-while-revalidate=300

# Cache statique haute performance (1 an) pour les assets immuables
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Interfaces d'administration privées (protection stricte zéro cache)
/admin.html
  Cache-Control: private, no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-store
  CDN-Cache-Control: no-store

/console-admin.html
  Cache-Control: private, no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-store
  CDN-Cache-Control: no-store

/editeur.html
  Cache-Control: private, no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-store
  CDN-Cache-Control: no-store

# Cache contrôlé Edge pour la racine et les pages HTML avec qualification serve-stale et annonce Markdown
/
  Cache-Control: public, max-age=600, s-maxage=600, stale-while-revalidate=86400, stale-if-error=86400
  Cloudflare-CDN-Cache-Control: max-age=600, stale-while-revalidate=86400, stale-if-error=86400
  CDN-Cache-Control: max-age=600, stale-while-revalidate=86400, stale-if-error=86400
  Link: </llms.txt>; rel="alternate"; type="text/markdown", </llms.txt>; rel="llms-txt"

/*.html
  Cache-Control: public, max-age=600, s-maxage=600, stale-while-revalidate=86400, stale-if-error=86400
  Cloudflare-CDN-Cache-Control: max-age=600, stale-while-revalidate=86400, stale-if-error=86400
  CDN-Cache-Control: max-age=600, stale-while-revalidate=86400, stale-if-error=86400
  Link: </llms.txt>; rel="alternate"; type="text/markdown", </llms.txt>; rel="llms-txt"

# Fichiers IA / LLM (Standard ouvert)
/llms.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8

# Signalement de sécurité responsable (RFC 9116 security.txt)
/.well-known/security.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/security.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400


